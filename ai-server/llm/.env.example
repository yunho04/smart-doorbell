# 이 파일을 .env로 복사해서 사용 (.env는 GitHub에 올리지 않음)

# 기능 전환 (mock -> 실제 구현)
STT_BACKEND=mock
LLM_BACKEND=mock
LLM_API_KEY=
LLM_MODEL=

# Spring 주소: 통합 당일에는 Mac의 실제 LAN IP로 변경 (localhost 금지)
SPRING_BASE_URL=http://localhost:8080
SPRING_TIMEOUT_SEC=3

# Vision 서버 주소 (대표 사진 번호 전달용): http://<Vision 컴퓨터 IP>:8000
VISION_BASE_URL=
VISION_API_TOKEN=

# 중간 대사를 Spring /response로도 보낼지 (기본 false: Pi B가 /audio 응답으로 바로 재생)
SEND_RESPONSE_TO_SPRING=false

# 인증: MVP v1에서는 사용하지 않음 (비워 둠)
DEVICE_KEYS=
INTERNAL_TOKEN=

EVENT_CACHE_TTL_SEC=3600
PURPOSE_CONF_THRESHOLD=0.6
MAX_TURNS=3
RAG_TOP_K=5
