# 이 파일을 .env로 복사해서 사용 (.env는 GitHub에 올리지 않음)

# ---------- STT·LLM: Groq ----------
# groq: Groq API 사용 / mock: 키 없이 흐름 테스트 (키가 비어 있으면 자동으로 mock)
STT_BACKEND=groq
LLM_BACKEND=groq
# Groq 키 (https://console.groq.com/keys). GitHub·채팅에 절대 올리지 말 것
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FAST_MODEL=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=ko

# Spring 주소: 통합 당일에는 Mac의 실제 LAN IP로 변경 (localhost 금지)
SPRING_BASE_URL=http://localhost:8080
SPRING_TIMEOUT_SEC=3

# Vision 서버 주소 (대표 사진 번호 전달용): http://<Vision 컴퓨터 IP>:8000
VISION_BASE_URL=
VISION_API_TOKEN=

# 중간 대사를 Spring /response로도 보낼지 (기본 false: Pi B가 /audio 응답으로 바로 재생)
SEND_RESPONSE_TO_SPRING=false

# 인증: MVP v1에서는 사용하지 않음 (비워 둠)
DEVICE_KEYS=
INTERNAL_TOKEN=

EVENT_CACHE_TTL_SEC=3600
PURPOSE_CONF_THRESHOLD=0.6
MAX_TURNS=3
RAG_TOP_K=5
